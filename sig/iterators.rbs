module Unisender
  class Client
    def each_campaign: (from: String | Time, ?to: String | Time | nil, ?page_size: Integer, ?max_pages: Integer, ?offset: Integer) ?{ (Campaign) -> void } -> Enumerator[Campaign, void]
    def each_message: (date_from: String | Time, date_to: String | Time, ?page_size: Integer, ?max_pages: Integer, ?offset: Integer) ?{ (Message) -> void } -> Enumerator[Message, void]
    def each_message_summary: (date_from: String | Time, date_to: String | Time, ?page_size: Integer, ?max_pages: Integer, ?offset: Integer) ?{ (Message) -> void } -> Enumerator[Message, void]
    def each_template: (?type: template_type | nil, ?date_from: String | Time | nil, ?date_to: String | Time | nil, ?page_size: Integer, ?max_pages: Integer, ?offset: Integer) ?{ (Template) -> void } -> Enumerator[Template, void]
    def each_template_summary: (?type: template_type | nil, ?date_from: String | Time | nil, ?date_to: String | Time | nil, ?page_size: Integer, ?max_pages: Integer, ?offset: Integer) ?{ (Template) -> void } -> Enumerator[Template, void]
    def each_sender_domain_group: (username: String, ?domain: String | nil, ?page_size: Integer, ?max_pages: Integer, ?offset: Integer) ?{ (SenderDomainGroup) -> void } -> Enumerator[SenderDomainGroup, void]
    def each_subscriber_note: (subscriber_id: id, ?order_type: note_order | nil, ?order_by: note_field | nil, ?is_pinned: flag | nil, ?page_size: Integer, ?max_pages: Integer, ?offset: Integer) ?{ (Note) -> void } -> Enumerator[Note, void]
  end
end
