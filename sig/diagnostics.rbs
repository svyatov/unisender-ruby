module Unisender
  module Diagnostics
    TYPES: Hash[Module, String]
    FIELDS: Array[String]
    URLS: Hash[String, String]
    def self.type_name: (parameter | value) -> String
    def self.input_path: (String) -> String
    def self.path_segment: (String) -> String
    def self.for_error: (Error | ValidationError) -> Hash[Symbol, json]
    def self.error_fields: (Error) -> Hash[Symbol, json]
    def self.common_fields: (Error | ValidationError) -> Hash[Symbol, json]
    def self.validation_fields: (ValidationError) -> Hash[Symbol, json]
    def self.context_fields: (Error) -> Hash[Symbol, json]
    def self.batch_fields: (BatchError) -> Hash[Symbol, json]
    def self.underlying: (Error) -> (Error | ValidationError)?
  end
  class Error
    @context_http_status: Integer?
    @context_request_id: String?
    def diagnostics: () -> Hash[Symbol, json]
    def documentation_url: () -> String?
    def with_http: (status: Integer?, request_id: String?) -> self
    def http_status: () -> Integer?
    def diagnostic_response: () -> Response?
  end
  class APIError
    def safe_code: () -> String?
  end
  class InvalidResponseError
    attr_reader path: String?
    attr_reader expected_type: String?
    attr_reader actual_type: String?
    def initialize: (?String, ?path: String?, ?expected_type: String?, ?actual_type: String?) -> void
    def prepend_path: (String) -> self
    def to_s: () -> String
  end
end
