module Unisender
  interface _Downloader
    def download: (String, _Writable, max_bytes: Integer) -> DownloadReceipt
  end
  class TaskResponse < TaskResultResponse
    def completed?: () -> bool
    def failed?: () -> bool
    def pending?: () -> bool
    @client: Client
    attr_reader task_uuid: String
    def initialize: (TaskResultResponse, client: Client, task_uuid: String) -> void
    def wait: (?interval: duration, ?timeout: duration, ?clock: ( ^() -> Float)?, ?sleeper: ( ^(duration) -> void)?) ?{ (TaskResponse) -> void } -> TaskResponse
    def download_to: (_Writable, max_bytes: Integer, ?downloader: _Downloader) -> DownloadReceipt
  end
  class TaskFailedError < TaskError
  end
  class UnknownTaskStateError < TaskError
  end
  class TaskTimeoutError < TimeoutError
    attr_reader response: TaskResponse
    attr_reader task_uuid: String
    def initialize: (TaskResponse) -> void
  end
end
