module Unisender
  class Client
    USER_AGENT: String
  end
  type config_value = bool | RateLimiter | String | Symbol | duration | _Transport | RetryPolicy | Hash[String | Symbol, String?] | Hash[Symbol, String] | (^(RequestEvent) -> void) | (^(AcceptanceEvent) -> void) | nil

  interface _Environment
    def []: (String) -> String?
  end

  class RequestEvent < Data
    attr_reader operation: String
    attr_reader attempt: Integer
    attr_reader duration: Float
    attr_reader http_status: Integer?
    attr_reader outcome: Symbol
    attr_reader error_category: Symbol?
    attr_reader request_id: String?
    def self.new: (operation: String, attempt: Integer, duration: Float, http_status: Integer?, outcome: Symbol, error_category: Symbol?, request_id: String?) -> RequestEvent
  end

  module Observation
    def self.emit: ((^(RequestEvent) -> void)?, RequestEvent) -> void
    def self.event: (String, Integer, Float, HTTPResponse?, Exception?) -> RequestEvent
    def self.category: (Exception?) -> Symbol?
  end
  class Configuration
    DEFAULT_KEYS: Array[Symbol]
    TIMEOUT_KEYS: Array[Symbol]
    RETRY_KEYS: Array[Symbol]
    @state: ClientState
    @owns_transport: bool
    attr_reader rate_limiter: RateLimiter?
    attr_reader event_rate_limiter: RateLimiter?
    attr_reader acceptance_instrumentation: (^(AcceptanceEvent) -> void)?
    def close: () -> void
    def check_open!: () -> void
    @options: Hash[Symbol, config_value]
    attr_reader api_key: String
    attr_reader language: String
    attr_reader transport: _Transport
    attr_reader retry_policy: RetryPolicy
    attr_reader message_defaults: Hash[Symbol, String]
    attr_reader instrumentation: (^(RequestEvent) -> void)?
    def initialize: (api_key: String, ?language: String | Symbol, ?transport: _Transport?, ?retry_policy: RetryPolicy?, ?open_timeout: duration?, ?read_timeout: duration?, ?write_timeout: duration?, ?max_retries: Integer?, ?max_elapsed: duration?, ?message_defaults: Hash[String | Symbol, String?], ?instrumentation: (^(RequestEvent) -> void)?, ?persistent: bool, ?rate_limiter: RateLimiter?, ?event_rate_limiter: RateLimiter?, ?acceptance_instrumentation: (^(AcceptanceEvent) -> void)?) -> void
    def merge_defaults: (Hash[Symbol, config_value], Hash[Symbol, config_value]) -> void
    def options_for: (Hash[Symbol, config_value]) -> Hash[Symbol, config_value]
    def inspect: () -> String
    private
    def initialize_resources: (RateLimiter?, _Transport?, RateLimiter?, (^(AcceptanceEvent) -> void)?) -> void
    def validate_default_keys: (Hash[String | Symbol, String?]) -> void
    def timeout_options: (duration?, duration?, duration?) -> Hash[Symbol, duration]
    def clear_alternative: (Hash[Symbol, config_value], Hash[Symbol, config_value], Symbol, Array[Symbol]) -> void
    def credentials: (String, String | Symbol) -> [String, String]
    def build_transport: (_Transport?, duration?, duration?, duration?, bool) -> _Transport
    def build_retry: (RetryPolicy?, Integer?, duration?) -> RetryPolicy
    def default_value: (String?) -> String?
    def validate_conflicts: (_Transport | RetryPolicy | nil, Array[duration?]) -> void
    def defaults: (Hash[String | Symbol, String?]) -> Hash[Symbol, String]
    def normalize_defaults: (Hash[String | Symbol, String?]) -> Hash[Symbol, String?]
  end
end
