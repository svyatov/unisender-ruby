module Unisender
  class Record
    @values: Hash[String, value]
    def initialize: (Hash[String, json]) -> void
    def self.decode: (json) -> value
    def []: (String | Symbol) -> value
    def fetch: [Fallback] (String | Symbol, *Fallback) ?{ (String | Symbol) -> Fallback } -> (value | Fallback)
    def key?: (String | Symbol) -> bool
    def keys: () -> Array[String]
    def values: () -> Array[value]
    def dig: (String | Symbol, *(String | Integer)) -> value
    def to_h: () -> Hash[String, json]
    alias to_hash to_h
    def as_json: (?serialization_options?) -> Hash[String, json]
    def to_json: (?(serialization_options | JSON::State)?) -> String
    def self.copy: (value) -> json
    def ==: (BasicObject) -> bool
    def inspect: () -> String
    def normalize: () -> void
    def text: (String) -> String?
    def text!: (String) -> String
    def identifier!: (String) -> id
    def integer!: (String) -> Integer
    def integer: (String) -> Integer?
    def number: (String) -> (Integer | Float)?
    def invalid!: (String) -> bot
  end

  class CollectionResponse[out Item = Record] < Response[Array[Item]]
    include Enumerable[Item]
    def each: () -> Enumerator[Item, Array[Item]]
            | () { (Item) -> void } -> Array[Item]
    def []: (Integer) -> Item?
          | (Range[Integer]) -> Array[Item]?
          | (Integer, Integer) -> Array[Item]?
    def at: (Integer) -> Item?
    def fetch: [Fallback] (Integer, *Fallback) ?{ (Integer) -> Fallback } -> (Item | Fallback)
    def size: () -> Integer
    alias length size
    def empty?: () -> bool
  end

  class ObjectResponse[out Result < Record = Record] < Response[Result]
    def []: (String | Symbol) -> value
    def fetch: [Fallback] (String | Symbol, *Fallback) ?{ (String | Symbol) -> Fallback } -> (value | Fallback)
    def to_h: () -> Hash[String, json]
    def dig: (String | Symbol, *(String | Integer)) -> value
  end

  module Results
    MODELS: Hash[String, [singleton(Record), singleton(ObjectResponse)]]
    COLLECTION_OPERATIONS: Array[String]
    EMPTY_OPERATIONS: Array[String]
    def self.build: (String, Response[json]) -> Response
    def self.boolean: (Response[json]) -> Response[json]
    def self.validate_container: (String, json) -> void
    def self.object: (singleton(Record), json) -> Record
    def self.normalize: (String, json) -> json
    def self.single_message: (json) -> json
    def self.wrap: (json, singleton(Record), singleton(ObjectResponse), Response[json]) -> Response
    def self.rows: (json) -> Array[Hash[String, json]]
    def self.field_names: (Array[json]) -> Array[String]
    def self.row_object: (Array[String], json) -> Hash[String, json]
  end
end
