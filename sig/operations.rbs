module Unisender
  type id = String | Integer
  type flag = bool | 0 | 1
  type contact_type = :email | :phone | "email" | "phone"
  type template_type = :user | :system | "user" | "system"
  type note_order = :asc | :desc | "ASC" | "DESC" | "asc" | "desc"
  type note_field = :created_at | :updated_at | :pinned_at | "created_at" | "updated_at" | "pinned_at"
  type list = List
  type list_created = IdentifierRecord
  type subscription = Subscription
  type message_created = MessageCreated
  type campaign_created = CampaignCreated
  type task_created = TaskResult
  type task_completed = TaskResult

  type object = Record
  type objects = Array[Record]
  type contact_count = ContactCount
  type total_contacts = TotalContacts
  type delivery_status = Status
  type message_version = MessageVersion
  type note = Note
  type event_accepted = Record

  class Client
    def create_list: (title: String, ?before_subscribe_url: String | nil, ?after_subscribe_url: String | nil, ?sub_user_rights: params | nil) -> IdentifierRecordResponse
    def delete_list: (list_id: id) -> ObjectResponse[Record]
    def exclude: (?contact_type: contact_type?, ?contact: String?, ?email: String?, ?phone: String?, ?list_ids: String | Array[id] | nil) -> ObjectResponse[Record]
    def export_contacts: (?notify_url: String | nil, ?list_id: id | nil, ?field_names: Array[String] | nil, ?email: String | nil, ?phone: String | nil, ?tag: String | nil, ?email_status: String | nil, ?phone_status: String | nil, ?contact_status: String | nil) -> TaskResponse
    def get_contact_count: (list_id: id, ?params: params?, ?tag_id: id?, ?contact_type: contact_type | "address" | nil, ?search: String?) -> ContactCountResponse
    def get_lists: () -> CollectionResponse[List]
    def get_total_contacts_count: (login: String) -> TotalContactsResponse
    def import_contacts: (?field_names: Array[String]?, ?data: Array[Array[parameter]]?, ?records: Enumerable[params]?, ?overwrite_tags: flag | nil, ?overwrite_lists: flag | nil, ?telegram_bot_channel_id: String | nil) -> ImportResponse
    def subscribe: (list_ids: String | Array[id], ?fields: params?, ?email: String?, ?tags: String | Array[id] | nil, ?double_optin: Integer | :request_confirmation | :already_confirmed | :confirm_if_needed | nil, ?overwrite: Integer | :preserve | :replace | :update | nil) -> SubscriptionResponse
    def update_list: (list_id: id, title: String, ?before_subscribe_url: String | nil, ?after_subscribe_url: String | nil, ?sub_user_rights: params | nil) -> ObjectResponse[Record]
    def is_contact_in_lists: (email: String, list_ids: String | Array[id], condition: String) -> Response[bool]
    def get_contact: (email: String, ?include_lists: flag | nil, ?include_fields: flag | nil, ?include_details: flag | nil) -> ContactResponse
    def unsubscribe: (?contact_type: contact_type?, ?contact: String?, ?email: String?, ?phone: String?, ?list_ids: String | Array[id] | nil) -> ObjectResponse[Record]
    def cancel_campaign: (campaign_id: id) -> ObjectResponse[Record]
    def check_email: (email_id: String | Array[id]) -> CollectionResponse[EmailDelivery]
    def check_sms: (sms_id: id) -> StatusResponse
    def create_campaign: (message_id: id, ?start_time: String | Time | nil, ?timezone: String | nil, ?track_read: flag | nil, ?track_links: flag | nil, ?contacts: String | Array[id] | nil, ?contacts_url: String | nil, ?track_ga: flag | nil, ?payment_limit: Integer | Float | nil, ?payment_currency: String | nil, ?ga_medium: String | nil, ?ga_source: String | nil, ?ga_campaign: String | nil, ?ga_content: String | nil, ?ga_term: String | nil) -> CampaignCreatedResponse
    def create_email_message: (?sender_name: String?, ?sender_email: String?, list_id: id, ?subject: String | nil, ?body: String | nil, ?text_body: String | nil, ?generate_text: flag | nil, ?tag: String | nil, ?attachments: Hash[String, String] | Attachment | Array[Attachment] | nil, ?lang: String | nil, ?template_id: id | nil, ?system_template_id: id | nil, ?wrap_type: String | nil, ?categories: String | Array[id] | nil) -> MessageCreatedResponse
    def create_sms_message: (sender: String, body: String, list_id: id, ?tag: String | nil) -> MessageCreatedResponse
    def delete_message: (message_id: id) -> ObjectResponse[Record]
    def get_actual_message_version: (message_id: id) -> MessageVersionResponse
    def get_web_version: (campaign_id: id) -> WebVersionResponse
    def send_email: (email: String, ?sender_name: String?, ?sender_email: String?, subject: String, body: String, list_id: id, ?attachments: Hash[String, String] | Attachment | Array[Attachment] | nil, ?lang: String | nil, ?track_read: flag | nil, ?track_links: flag | nil, ?cc: String | nil, ?headers: String | params | nil, ?images_as: String | nil, ?ref_key: String | nil, ?error_checking: flag | nil, ?metadata: params | nil) -> SendResponse
    def send_sms: (phone: String | Array[String], sender: String, text: String) -> CollectionResponse[SmsReceipt]
    def send_test_email: (email: String | Array[id], id: id) -> MessageNoticeResponse
    def update_email_message: (id: id, ?sender_name: String | nil, ?sender_email: String | nil, ?subject: String | nil, ?body: String | nil, ?list_id: id | nil, ?text_body: String | nil, ?lang: String | nil, ?categories: String | Array[id] | nil) -> MessageCreatedResponse
    def update_opt_in_email: (sender_name: String, sender_email: String, subject: String, body: String, list_id: id) -> ObjectResponse[Record]
    def get_sender_domain_list: (username: String, ?domain: String | nil, ?limit: Integer | nil, ?offset: Integer | nil) -> PageResponse[SenderDomainGroup]
    def get_campaign_common_stats: (campaign_id: id) -> CampaignStatsResponse
    def get_campaign_delivery_stats: (campaign_id: id, ?notify_url: String | nil, ?changed_since: String | Time | nil, ?field_ids: Array[id] | nil) -> TaskResponse
    def get_campaign_status: (campaign_id: id) -> StatusResponse
    def get_messages: (date_from: String | Time, date_to: String | Time, ?limit: Integer | nil, ?offset: Integer | nil) -> PageResponse[Message]
    def get_visited_links: (campaign_id: id, ?group: flag | nil) -> CollectionResponse[Record]
    def list_messages: (date_from: String | Time, date_to: String | Time, ?limit: Integer | nil, ?offset: Integer | nil) -> PageResponse[Message]
    def get_campaigns: (from: String | Time, ?to: String | Time | nil, ?limit: Integer | nil, ?offset: Integer | nil) -> PageResponse[Campaign]
    def get_message: (id: id) -> MessageResponse
    def get_task_result: (task_uuid: String) -> TaskResponse
    def create_email_template: (title: String, subject: String, body: String, ?description: String | nil, ?text_body: String | nil, ?lang: String | nil) -> IdentifierRecordResponse
    def delete_template: (template_id: id) -> ObjectResponse[Record]
    def get_template: (?template_id: id | nil, ?system_template_id: id | nil) -> TemplateResponse
    def get_templates: (?type: template_type | nil, ?date_from: String | Time | nil, ?date_to: String | Time | nil, ?limit: Integer | nil, ?offset: Integer | nil) -> PageResponse[Template]
    def list_templates: (?type: template_type | nil, ?date_from: String | Time | nil, ?date_to: String | Time | nil, ?limit: Integer | nil, ?offset: Integer | nil) -> PageResponse[Template]
    def update_email_template: (template_id: id, ?title: String | nil, ?description: String | nil, ?subject: String | nil, ?body: String | nil, ?text_body: String | nil, ?lang: String | nil) -> IdentifierRecordResponse
    def create_field: (name: String, type: String, ?public_name: String | nil) -> IdentifierRecordResponse
    def delete_field: (id: id) -> ObjectResponse[Record]
    def delete_tag: (id: id) -> ObjectResponse[Record]
    def get_fields: () -> CollectionResponse[Field]
    def get_tags: () -> CollectionResponse[Tag]
    def update_field: (id: id, name: String, ?public_name: String | nil) -> OptionalIdentifierResponse
    def get_contact_field_values: (email: String, field_ids: String | Array[id]) -> ContactFieldsResponse
    def create_subscriber_note: (subscriber_id: id, content: String) -> IdentifierRecordResponse
    def update_subscriber_note: (id: id, content: String) -> IdentifierRecordResponse
    def delete_subscriber_note: (id: id) -> ObjectResponse[Record]
    def get_subscriber_note: (id: id) -> NoteResponse
    def get_subscriber_notes: (subscriber_id: id, ?limit: Integer | nil, ?offset: Integer | nil, ?order_type: note_order | nil, ?order_by: note_field | nil, ?is_pinned: flag | nil) -> PageResponse[Note]
  end
end
