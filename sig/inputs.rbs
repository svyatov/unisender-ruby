module Unisender
  module NamedInputs
    EMPTY_ENUMS: Hash[Symbol, Array[String]]
    FLAGS: Hash[String, Array[Symbol]]
    ENUMS: Hash[String, Hash[Symbol, Array[String]]]
    def self.normalize: (String, params) -> params
    def self.flag!: (Symbol, parameter, String) -> void
    def self.choice: (parameter, Symbol, Array[String], String) -> String
  end
  class ValidationError < ArgumentError
    attr_reader field: String
    attr_reader code: Symbol
    attr_reader operation: String?
    attr_reader index: Integer?
    attr_reader expected_type: String?
    attr_reader actual_type: String?
    alias path field
    def diagnostics: () -> Hash[Symbol, json]
    def documentation_url: () -> String?
    def initialize: (field: String, code: Symbol, ?operation: String?, ?index: Integer?, ?expected_type: String?, ?actual_type: String?) -> void
    def with_operation: (String) -> self
    def category: () -> Symbol
    def recovery_hint: () -> String
    def transient?: () -> bool
    def safe_to_retry?: () -> bool
  end

  module Inputs
    def self.operation_values: (String, params) -> params
    def self.schedule_timezone!: (params) -> void
    MODES: Hash[Symbol, Hash[Symbol, Integer]]
    MINUTES: Array[String]
    SECONDS: Array[String]
    DATES: Array[Symbol]
    def self.attachments: (parameter) -> parameter
    def self.attachment_parameters: (params) -> params
    def self.attachment_items: (parameter) -> Array[Attachment]
    def self.normalize: (String, params) -> params
    def self.timestamp_format: (String) -> String?
    def self.mode: (parameter, Hash[Symbol, Integer], Symbol) -> Integer?
    def self.timestamp: (parameter, String, Symbol) -> String?
    def self.contact_fields: (parameter, parameter) -> params
    def self.merge_email: (params, parameter) -> parameter
    def self.validate_email: (params) -> void
  end

  module ContactInputs
    def self.filter_container: (parameter) -> params?
    def self.contact_selector: (params, String) -> params
    def self.validate_selector: (params, params, String) -> void
    def self.count_filters: (parameter, parameter, parameter, parameter) -> params
    def self.count_contact_type: (parameter) -> String?
    def self.validate_filters: (parameter, parameter) -> void
  end

  module SmsInputs
    def self.phone: (parameter) -> String
  end

  class RecordRows
    def self.bounded: (Enumerable[params]) -> RecordRows
    include Enumerable[Array[parameter]]
    @records: Enumerable[params]
    @rows: Array[Array[parameter]]?
    attr_reader field_names: Array[String]
    def initialize: (Enumerable[params]) -> void
    def each: () { (Array[parameter]) -> void } -> void
    private
    def row: (parameter, Integer) -> Array[parameter]
    def record_object: (parameter, Integer) -> params
    def validate_columns: (Array[String], Integer) -> void
  end
  module ImportCells
    LISTS: Array[String]
    TIMES: Array[String]
    def self.convert: (String, parameter, Integer) -> parameter
    def self.array: (String, Array[parameter], Integer) -> String
    def self.list: (Array[parameter], Integer) -> String
    def self.times: (Array[parameter] | Time, Integer) -> String
    def self.validate_times: (Hash[String, parameter], Integer) -> void
    def self.invalid!: (Integer) -> bot
  end
end
