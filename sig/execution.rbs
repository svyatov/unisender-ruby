module Unisender
  module Iteration
    def self.call: [Item] (Enumerator[Item, void]) ?{ (Item) -> void } -> Enumerator[Item, void]
  end
  class BatchReport
    include Enumerable[Response]
    attr_reader responses: Array[Response]
    def initialize: (Array[Response]) -> void
    def each: () -> Enumerator[Response, Array[Response]]
            | () { (Response) -> void } -> Array[Response]
    def complete?: () -> bool
    def completed_batches: () -> Integer
  end

  class PageResponse[out Item < Record = Record] < CollectionResponse[Item]
    @client: Client
    @method: String
    @params: params
    def initialize: (CollectionResponse[Item], client: Client, method: String, params: params) -> void
    def each_page: (?max_pages: Integer) -> Enumerator[PageResponse[Item], void]
    def auto_each: (?max_pages: Integer) -> Enumerator[Item, void]
  end
end
