module Unisender
  interface _Readable
    def read: () -> String?
  end
  class Attachment
    attr_reader filename: String
    attr_reader bytes: String
    def initialize: (filename: String, bytes: String) -> void
    def self.from_path: (String, ?filename: String) -> Attachment
    def self.from_io: (_Readable, filename: String) -> Attachment
    def inspect: () -> String
  end
end
